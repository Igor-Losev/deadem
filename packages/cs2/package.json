{
  "name": "@deademx/cs2",
  "version": "5.0.0",
  "description": "Source 2 demo toolkit (parser, player, cutter) for Counter-Strike 2 in Node.js, Deno, Bun and browsers",
  "author": "Igor Losev",
  "license": "MIT",
  "bugs": "https://github.com/Igor-Losev/deadem/issues",
  "homepage": "https://deadem.com",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Igor-Losev/deadem.git",
    "directory": "packages/cs2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deadem",
    "cs2",
    "counter-strike",
    "counter-strike-2",
    "cs2-parser",
    "cs2-demo-parser",
    "cs2-replay-parser",
    "cs2-demo-cutter",
    "cs2-replay-cutter",
    "valve",
    "source-2",
    "dem",
    "demo",
    "replay",
    "parser",
    "player",
    "cutter",
    "demo-parser",
    "replay-parser",
    "demo-cutter",
    "replay-cutter",
    "nodejs",
    "browser",
    "deno",
    "bun"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./proto": {
      "types": "./proto/generated/index.d.ts",
      "import": "./proto/generated/index.js",
      "default": "./proto/generated/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "unpkg": "dist/deadem-cs2.min.js",
  "jsdelivr": "dist/deadem-cs2.min.js",
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "lint": "eslint",
    "prepack": "tsc -b ./tsconfig.emit.json --clean && rm -rf types && tsc -b ./tsconfig.emit.json"
  },
  "files": [
    "dist/**",
    "index.js",
    "proto/generated/**",
    "src/**",
    "types/**"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@deademx/engine": "^5.0.0"
  }
}
