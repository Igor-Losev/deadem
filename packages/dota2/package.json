{
  "name": "@deademx/dota2",
  "version": "4.0.1",
  "description": "Dota 2 (Source 2) demo and replay parser with playback support for Node.js and browsers",
  "author": "Igor Losev",
  "license": "MIT",
  "bugs": "https://github.com/Igor-Losev/deadem/issues",
  "homepage": "https://deadem.com",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Igor-Losev/deadem.git",
    "directory": "packages/dota2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deadem",
    "dota2",
    "dota",
    "dota2-parser",
    "dota2-demo-parser",
    "dota2-replay-parser",
    "valve",
    "source-2",
    "dem",
    "demo",
    "replay",
    "parser",
    "player",
    "demo-parser",
    "replay-parser",
    "nodejs",
    "browser",
    "deno",
    "bun"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "unpkg": "dist/deadem-dota2.min.js",
  "jsdelivr": "dist/deadem-dota2.min.js",
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "lint": "eslint",
    "prepack": "tsc -b ./tsconfig.emit.json --clean && tsc -b ./tsconfig.emit.json",
    "proto:js": "node ./../../scripts/proto-schema-build.js --package=dota2",
    "proto:sync": "node ./../../.github/scripts/proto-sync.mjs dota2"
  },
  "files": [
    "dist/**",
    "index.js",
    "proto/compiled/**",
    "src/**",
    "types/**"
  ],
  "dependencies": {
    "@deademx/engine": "^4.0.1"
  }
}
