{
  "name": "@deademx/dota2",
  "version": "3.4.1",
  "description": "Dota 2 (Source 2) demo and replay parser with playback support for Node.js and browsers",
  "author": "Igor Losev",
  "license": "MIT",
  "bugs": "https://github.com/Igor-Losev/deadem/issues",
  "homepage": "https://deadem.com",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Igor-Losev/deadem.git",
    "directory": "packages/dota2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deadem",
    "dota2",
    "dota",
    "dota2-parser",
    "dota2-demo-parser",
    "dota2-replay-parser",
    "valve",
    "source-2",
    "dem",
    "demo",
    "replay",
    "parser",
    "player",
    "demo-parser",
    "replay-parser",
    "nodejs",
    "browser",
    "deno",
    "bun"
  ],
  "type": "module",
  "main": "index.js",
  "unpkg": "dist/deadem-dota2.min.js",
  "jsdelivr": "dist/deadem-dota2.min.js",
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "lint": "eslint",
    "proto:json": "node ./../../scripts/proto-schema-build.js --package=dota2",
    "proto:sync": "node ./../../.github/scripts/proto-sync.mjs dota2"
  },
  "files": [
    "dist/**",
    "index.js",
    "proto/compiled/**",
    "src/**"
  ],
  "imports": {
    "#src/*.js": "./src/*.js",
    "#bootstrap/*.js": "./src/bootstrap/*.js",
    "#data/*.js": "./src/data/*.js",
    "#providers/ProtoProvider.instance.js": "./src/providers/ProtoProvider.instance.js"
  },
  "dependencies": {
    "@deademx/engine": "3.4.1"
  }
}
