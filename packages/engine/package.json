{
  "name": "@deademx/engine",
  "version": "4.0.1",
  "description": "Shared Source 2 demo parsing and replay playback engine for Node.js and browsers",
  "author": "Igor Losev",
  "license": "MIT",
  "bugs": "https://github.com/Igor-Losev/deadem/issues",
  "homepage": "https://deadem.com",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Igor-Losev/deadem.git",
    "directory": "packages/engine"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deadem",
    "valve",
    "source-2",
    "dem",
    "demo",
    "replay",
    "parser",
    "player",
    "demo-parser",
    "replay-parser",
    "nodejs",
    "browser",
    "deno",
    "bun"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint",
    "prepack": "tsc -b ./tsconfig.emit.json --clean && rm -rf types && tsc -b ./tsconfig.emit.json",
    "test": "vitest run"
  },
  "files": [
    "index.js",
    "src/**",
    "types/**"
  ],
  "imports": {
    "#broadcast/BroadcastReadStream.js": {
      "types": "./types/src/broadcast/BroadcastReadStream.node.d.ts",
      "electron": {
        "browser": "./src/broadcast/BroadcastReadStream.browser.js",
        "default": "./src/broadcast/BroadcastReadStream.node.js"
      },
      "node": "./src/broadcast/BroadcastReadStream.node.js",
      "browser": "./src/broadcast/BroadcastReadStream.browser.js",
      "default": "./src/broadcast/BroadcastReadStream.browser.js"
    },
    "#core/stream/Pipeline.js": {
      "types": "./types/src/core/stream/Pipeline.node.d.ts",
      "electron": {
        "browser": "./src/core/stream/Pipeline.browser.js",
        "default": "./src/core/stream/Pipeline.node.js"
      },
      "node": "./src/core/stream/Pipeline.node.js",
      "browser": "./src/core/stream/Pipeline.browser.js",
      "default": "./src/core/stream/Pipeline.browser.js"
    },
    "#core/stream/ReadableArray.js": {
      "types": "./types/src/core/stream/ReadableArray.node.d.ts",
      "electron": {
        "browser": "./src/core/stream/ReadableArray.browser.js",
        "default": "./src/core/stream/ReadableArray.node.js"
      },
      "node": "./src/core/stream/ReadableArray.node.js",
      "browser": "./src/core/stream/ReadableArray.browser.js",
      "default": "./src/core/stream/ReadableArray.browser.js"
    },
    "#core/stream/Transform.js": {
      "types": "./types/src/core/stream/Transform.node.d.ts",
      "electron": {
        "browser": "./src/core/stream/Transform.browser.js",
        "default": "./src/core/stream/Transform.node.js"
      },
      "node": "./src/core/stream/Transform.node.js",
      "browser": "./src/core/stream/Transform.browser.js",
      "default": "./src/core/stream/Transform.browser.js"
    },
    "#core/stream/WritableSink.js": {
      "types": "./types/src/core/stream/WritableSink.node.d.ts",
      "electron": {
        "browser": "./src/core/stream/WritableSink.browser.js",
        "default": "./src/core/stream/WritableSink.node.js"
      },
      "node": "./src/core/stream/WritableSink.node.js",
      "browser": "./src/core/stream/WritableSink.browser.js",
      "default": "./src/core/stream/WritableSink.browser.js"
    },
    "#trackers/MemoryTracker.js": {
      "types": "./types/src/trackers/MemoryTracker.node.d.ts",
      "electron": {
        "browser": "./src/trackers/MemoryTracker.browser.js",
        "default": "./src/trackers/MemoryTracker.node.js"
      },
      "node": "./src/trackers/MemoryTracker.node.js",
      "browser": "./src/trackers/MemoryTracker.browser.js",
      "default": "./src/trackers/MemoryTracker.browser.js"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "snappyjs": "^0.7.0"
  }
}
